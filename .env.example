# CalmIq environment variables
# Copy to `.env.local` for local development.
# Set the same keys in Vercel → Project → Settings → Environment Variables
# (Production + Preview).

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Auth + Postgres + RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Checkout + Customer Portal + webhooks)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CALM_PLUS=

# AI (Vercel AI SDK / Google Gemini)
# Comma-separated keys supported; the first non-empty key is used.
GEMINI_KNOWLEDGE_API_KEYS=
# Optional; defaults to gemini-2.5-flash when unset.
GEMINI_MODEL=gemini-2.5-flash

# Notes:
# - Without Supabase keys the app runs in demo mode (cookie-based auth + plan simulation).
# - Without GEMINI_KNOWLEDGE_API_KEYS the chat API returns a streamed demo reply.
# - Without Stripe keys, Checkout upgrades the demo plan locally.
# - Stripe webhook endpoint: https://<your-domain>/api/stripe/webhook
#   Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# - Apply SQL in supabase/migrations/001_init.sql to your Supabase project.
# - Add Supabase Auth redirect URLs for Vercel prod + preview origins + /api/auth/callback
